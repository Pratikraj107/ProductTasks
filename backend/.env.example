# Optional: ElevenLabs (AI Interviewer TTS)
# ELEVENLABS_API_KEY=your_key_here

# MSG91 (SMS/OTP for mobile auth)
MSG91_AUTH_KEY=your_msg91_auth_key_here
# Optional: Sender ID (6 chars, set in MSG91 dashboard if required)
# MSG91_SENDER_ID=ABCDEF
# Optional: Template ID if using MSG91 template
# MSG91_OTP_TEMPLATE_ID=your_template_id_here

# Supabase (required for mobile auth + usage tracker)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
